# VulnTrace AI Environment Configuration
# Copy this file to .env and customize values. Do not commit .env to version control.

# Groq LLM API Configuration
# Candidate model per PRD: openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# FalkorDB Configuration (openCypher over Redis protocol)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Sandbox & Validation Limits (PRD §12 Safeguard S5)
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MAX_MEMORY_MB=512
ENABLE_DOCKER_SANDBOX=true

# Demo & Offline Cache Settings
OFFLINE_FIXTURE_MODE=false
